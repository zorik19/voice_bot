# Скопируй этот файл в .env и заполни своими ключами (или используй .env,
# который тебе прислали отдельно, если он уже готов).

# Провайдеры: меняешь строку — меняется контур
VOICEBOT_STT_PROVIDER=whisper        # whisper | yandex
VOICEBOT_LLM_PROVIDER=gigachat       # gigachat | claude
VOICEBOT_TTS_PROVIDER=silero         # silero | elevenlabs | yandex

# GigaChat (основной LLM): Authorization key из ЛК developers.sber.ru
VOICEBOT_GIGACHAT_AUTH_KEY=
VOICEBOT_GIGACHAT_SCOPE=GIGACHAT_API_PERS
VOICEBOT_GIGACHAT_MODEL=GigaChat-2-Max

# Claude (опционально, альтернатива)
VOICEBOT_ANTHROPIC_API_KEY=

# ElevenLabs (опционально, wow-голос на демо)
VOICEBOT_ELEVENLABS_API_KEY=

# Yandex SpeechKit (на будущее, для прода)
VOICEBOT_YANDEX_API_KEY=
VOICEBOT_YANDEX_FOLDER_ID=
VOICEBOT_YANDEX_ROLE=
VOICEBOT_YANDEX_SPEED=

# Аудио-профиль: mic | phone
VOICEBOT_AUDIO_PROFILE=mic
VOICEBOT_AMBIENCE_GAIN=